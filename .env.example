VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here

# Google Apps Script Web App URL for the "Website Leads" sheet tab
VITE_SHEET_WEBAPP_URL=your_apps_script_web_app_url_here

# ---- Member accounts (Supabase) -------------------------------------------
# Public values, bundled into the browser. Safe to expose (RLS protects data).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ---- Server only (Vercel /api functions). NEVER prefix these with VITE_. ----
# Supabase service-role / secret key (bypasses RLS).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_sb_secret_key

# Razorpay (test mode: rzp_test_...). Live keys are refused unless RAZORPAY_ALLOW_LIVE=true.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Torque for Instagram — ₹750/month plan
RAZORPAY_PLAN_ID=plan_your_monthly_plan_id
# Torque for LinkedIn — ₹500/month plan (separate plan; LinkedIn is hidden until set)
RAZORPAY_LINKEDIN_PLAN_ID=plan_your_linkedin_plan_id
# RAZORPAY_ALLOW_LIVE=true   # only after going live is approved
